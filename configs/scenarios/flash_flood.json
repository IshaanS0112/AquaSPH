{
  "name": "flash_flood",
  "tier": 2,
  "description": "Rapid-onset surge down a confined channel driven by a sharply peaked inflow hydrograph.",
  "approximation": "TIER 2 -- QUALITATIVE ONLY. The hydrograph is an invented keyframe curve, not a rainfall-runoff model, and the channel is a smooth analytic trough with no bed roughness or debris. This shows what a rapid-onset surge looks like; it does not predict one.",

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [2.4, 0.5, 0.6],
    "faces": { "x_max": "open", "y_max": "open" },
    "boundary_particles": true,
    "boundary_layers": 2
  },

  "materials": [
    { "name": "water", "rest_density": 1000.0, "sound_speed": 25.0, "gamma": 7.0,
      "viscosity": 5.0, "surface_tension": 0.0, "absorption": [0.55, 0.16, 0.09] }
  ],

  "fluid_regions": [
    { "type": "box", "material": "water", "min": [0.0, 0.05, 0.12], "max": [2.4, 0.09, 0.48] }
  ],

  "emitters": [
    {
      "type": "box", "material": "water",
      "min": [0.03, 0.06, 0.16], "max": [0.06, 0.30, 0.44],
      "direction": [1.0, 0.0, 0.0], "speed": 2.2,
      "schedule": {
        "kind": "keyframes",
        "keys": [[0.0, 0.05], [0.6, 0.12], [1.0, 1.0], [1.6, 0.85], [2.6, 0.3], [4.0, 0.12]]
      }
    }
  ],

  "obstacles": [
    {
      "name": "channel",
      "type": "heightfield",
      "min": [0.0, 0.0, 0.0], "max": [2.4, 0.5, 0.6],
      "field": {
        "base": 0.30, "origin": [0.0, 0.30], "slope": [-0.03, 0.0],
        "min_height": 0.0, "max_height": 0.34,
        "bumps": [ { "amplitude": -0.28, "center": [1.2, 0.30], "sigma": 0.18 } ]
      }
    }
  ],

  "sinks": [ { "type": "box", "min": [2.3, 0.0, 0.0], "max": [2.4, 0.5, 0.6] } ],

  "numerics": { "h": 0.03, "spacing_ratio": 0.5, "xsph_epsilon": 0.5, "dt_max": 0.001 },
  "duration": { "simulated_time": 4.0, "output_interval": 0.02 },

  "metrics": {
    "track_inundation": true,
    "inundation_depth": 0.03,
    "probes": [
      { "name": "head", "position": [0.6, 0.0, 0.3], "radius": 0.06 },
      { "name": "middle", "position": [1.4, 0.0, 0.3], "radius": 0.06 },
      { "name": "outlet", "position": [2.1, 0.0, 0.3], "radius": 0.06 }
    ]
  },

  "camera": { "target": [1.2, 0.15, 0.3], "distance": 3.4, "yaw_deg": 38.0, "pitch_deg": 24.0 },
  "render": { "mode": "surface", "reference_speed": 3.0, "palette": "teal" }
}
