{
  "name": "dam_break",
  "tier": 1,
  "description": "Collapse of a rectangular water column on a dry horizontal bed.",
  "approximation": "Idealised initial condition (the retaining wall is removed instantaneously and completely) and no wall roughness, both of which make the simulated surge run slightly ahead of the experiment during early collapse. See docs/validation.md.",

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [1.6, 0.6, 0.3],
    "faces": { "y_max": "open" },
    "boundary_particles": true,
    "boundary_layers": 2
  },
  "gravity": [0.0, -9.81, 0.0],

  "materials": [
    {
      "name": "water",
      "rest_density": 1000.0,
      "sound_speed": 45.0,
      "gamma": 7.0,
      "viscosity": 5.0,
      "surface_tension": 0.0,
      "absorption": [0.55, 0.16, 0.09]
    }
  ],

  "fluid_regions": [
    { "type": "column", "material": "water", "base": [0.0, 0.0, 0.0], "size": [0.25, 0.5, 0.3] }
  ],

  "numerics": {
    "h": 0.025,
    "spacing_ratio": 0.5,
    "xsph_epsilon": 0.5,
    "boundary_friction": 1.0,
    "dt_max": 0.001
  },

  "duration": { "simulated_time": 1.2, "output_interval": 0.01 },

  "metrics": {
    "track_surge_front": true,
    "surge_axis": "x",
    "surge_origin": 0.0,
    "surge_column_width": 0.25,
    "surge_column_height": 0.5,
    "probes": [
      { "name": "gauge_H1", "position": [0.8, 0.0, 0.15], "radius": 0.04 },
      { "name": "gauge_H2", "position": [1.4, 0.0, 0.15], "radius": 0.04 }
    ]
  },

  "camera": { "target": [0.8, 0.2, 0.15], "distance": 2.6, "yaw_deg": 38.0, "pitch_deg": 20.0 },
  "render": { "mode": "surface", "reference_speed": 3.5, "palette": "teal" }
}
