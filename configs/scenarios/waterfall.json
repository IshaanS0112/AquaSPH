{
  "name": "waterfall",
  "tier": 2,
  "description": "A continuous stream falls from a ledge into a plunge pool.",
  "approximation": "TIER 2 -- The plunge is a two-phase problem: a real waterfall entrains air and turns white. This solver is single-phase, so the plunge pool is rendered as clear water with no aeration, foam or spray. Those are Tier 3 extension points.",

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [1.0, 1.0, 0.5],
    "faces": { "y_max": "open" },
    "boundary_particles": true,
    "boundary_layers": 2
  },

  "materials": [
    { "name": "water", "rest_density": 1000.0, "sound_speed": 35.0, "gamma": 7.0,
      "viscosity": 3.0, "surface_tension": 0.05, "absorption": [0.55, 0.16, 0.09] }
  ],

  "fluid_regions": [
    { "type": "box", "material": "water", "min": [0.0, 0.0, 0.0], "max": [1.0, 0.12, 0.5] }
  ],

  "emitters": [
    {
      "type": "box", "material": "water",
      "min": [0.06, 0.80, 0.14], "max": [0.16, 0.83, 0.36],
      "direction": [0.35, -0.94, 0.0], "speed": 1.2
    }
  ],

  "obstacles": [
    { "name": "ledge", "type": "box", "min": [0.0, 0.0, 0.0], "max": [0.16, 0.80, 0.5] }
  ],

  "sinks": [ { "type": "box", "min": [0.0, 0.0, 0.0], "max": [1.0, 0.005, 0.5] } ],

  "numerics": { "h": 0.024, "spacing_ratio": 0.5, "xsph_epsilon": 0.5, "dt_max": 0.001 },
  "duration": { "simulated_time": 3.0, "output_interval": 0.02 },

  "metrics": {
    "probes": [
      { "name": "plunge", "position": [0.4, 0.0, 0.25], "radius": 0.06 },
      { "name": "pool_far", "position": [0.85, 0.0, 0.25], "radius": 0.06 }
    ]
  },

  "camera": { "target": [0.5, 0.4, 0.25], "distance": 2.4, "yaw_deg": 38.0, "pitch_deg": 12.0 },
  "render": { "mode": "surface", "reference_speed": 4.0, "palette": "teal" }
}
