# Any build directory, not just the canonical one.
build*/
*.o
*.obj
.cache/
.vscode/
.idea/
*.exe
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
# ...except the hand-written one at the root.
!/Makefile
compile_commands.json
*.log
_deps/
.DS_Store

# Generated output. results/validation/*.json is the exception and IS committed: those three
# files are the evidence behind docs/validation.md, they are a few kilobytes each, and a
# validation document whose inputs cannot be inspected is an assertion rather than a result.
results/*
!results/validation/
results/validation/*
!results/validation/*.json
gallery/
frames/

# Local runtime data of the Go services (artifacts written by a worker
# started from backend/ with the default AQUASPH_ARTIFACT_DIR) and built binaries.
backend/data/
backend/bin/
