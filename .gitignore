# Any build directory, not just the canonical one. `build/` alone let
# build-dbg/ and build-g/ -- scratch trees from an ASan and a
# RelWithDebInfo build -- get committed, which put 56 MB of object files
# and static libraries into the history before anyone noticed.
build*/
*.o
*.obj
.cache/
.vscode/
.idea/
*.exe
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json
*.log
_deps/
.DS_Store

# Generated output. results/validation/*.json is the exception and IS
# committed: those three files are the evidence behind docs/validation.md,
# they are a few kilobytes each, and a validation document whose inputs
# cannot be inspected is an assertion rather than a result.
results/*
!results/validation/
results/validation/*
!results/validation/*.json
gallery/
frames/
