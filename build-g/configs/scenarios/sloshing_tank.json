{
  "name": "sloshing_tank",
  "tier": 1,
  "description": "A partially filled tank is given a short horizontal impulse and then left to oscillate freely.",
  "approximation": "Free-slip-to-no-slip wall friction is a single tunable coefficient rather than a resolved boundary layer, so the measured decay rate is not predictive even though the oscillation period is.",

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [0.6, 0.3, 0.2],
    "faces": { "y_max": "open" },
    "boundary_particles": true,
    "boundary_layers": 2
  },

  "materials": [
    { "name": "water", "rest_density": 1000.0, "sound_speed": 15.0, "gamma": 7.0,
      "viscosity": 2.0, "surface_tension": 0.0, "absorption": [0.55, 0.16, 0.09] }
  ],

  "fluid_regions": [
    { "type": "box", "material": "water", "min": [0.0, 0.0, 0.0], "max": [0.6, 0.1, 0.2] }
  ],

  "external_forces": [
    {
      "name": "impulse",
      "direction": [1.0, 0.0, 0.0],
      "magnitude": { "kind": "pulse", "value": 2.0, "start": 0.1, "duration": 0.25 }
    }
  ],

  "numerics": { "h": 0.02, "spacing_ratio": 0.5, "xsph_epsilon": 0.5, "dt_max": 0.001 },
  "duration": { "simulated_time": 6.0, "output_interval": 0.02 },

  "metrics": {
    "probes": [
      { "name": "left_wall", "position": [0.03, 0.0, 0.1], "radius": 0.03 },
      { "name": "right_wall", "position": [0.57, 0.0, 0.1], "radius": 0.03 }
    ]
  },

  "camera": { "target": [0.3, 0.1, 0.1], "distance": 1.15, "yaw_deg": 38.0, "pitch_deg": 18.0 },
  "render": { "mode": "surface", "reference_speed": 1.2, "palette": "teal" }
}
